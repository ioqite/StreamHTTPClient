{
  "name": "StreamHTTPClient",
  "version": "1.0.2",
  "description": "A streaming HTTP/HTTPS client for Arduino with sync/async support, bidirectional streaming, SSE, chunked transfer, gzip decompression, keep-alive, redirects and BasicAuth. API-compatible with HTTPClient.",
  "keywords": ["http", "https", "streaming", "sse", "async", "gzip", "chunked", "wifi", "client", "tls"],
  "authors": [
    {
      "name": "Ioqit",
      "url": "https://github.com/ioqite",
      "maintainer": true
    }
  ],
  "license": "MIT License",
  "frameworks": "arduino",
  "platforms": ["espressif32", "espressif8266", "atmelavr", "atmelsam", "raspberrypi"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioqite/StreamHTTPClient"
  },
  "examples": [
    "examples/*/*.ino"
  ],
  "headers": ["StreamHTTPClient.h"]
}
